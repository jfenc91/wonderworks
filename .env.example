# Standalone runtime: Node 24. Sites uses its managed configuration instead.
WW_PROFILE=local
WW_AUTH=local
WW_HOST=127.0.0.1
WW_PORT=3000
WW_PUBLIC_URL=http://127.0.0.1:3000
# Optional absolute path; default ~/.local/share/wonderworks/workspace.sqlite
# WW_SQLITE_PATH=/private/local-disk/workspace.sqlite

# Compose/self-hosted: replace all placeholders, use mode-600 private files.
# WW_PROFILE=self-hosted
# WW_AUTH=accounts
# WW_HOST=0.0.0.0
# WW_POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
# WW_DATABASE_URL=postgresql://wonderworks:REPLACE_WITH_URL_SAFE_RANDOM_SECRET@database:5432/wonderworks
# WW_PG_TLS=verify-full
# WW_PG_CA_FILE=/run/wonderworks/postgres-ca.pem
# WW_ACCOUNTS_FILE=/absolute/private/accounts.json
# WW_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# WW_IMAGE_TAG=REPLACE_WITH_SOURCE_COMMIT
